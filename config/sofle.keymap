#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        mod_1: mod_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N1)>;
            label = "MOD_1";
        };

        mod_2: mod_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N2)>;
            label = "MOD_2";
        };

        mod_3: mod_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N3)>;
            label = "MOD_3";
        };

        mod_4: mod_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N4)>;
            label = "MOD_4";
        };

        mod_5: mod_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N5)>;
            label = "MOD_5";
        };

        mod_6: mod_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N6)>;
            label = "MOD_6";
        };

        mod_7: mod_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N7)>;
            label = "MOD_7";
        };

        mod_8: mod_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N8)>;
            label = "MOD_8";
        };

        mod_9: mod_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N9)>;
            label = "MOD_9";
        };

        mod_0: mod_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N0)>;
            label = "MOD_0";
        };

        mic_mute: mic_mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LSHFT &kp M>;
        };
    };

    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        mtt: mod_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "MTT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans           &trans  &trans       &trans        &trans     &trans                                         &trans           &trans  &trans            &trans         &trans    &trans
&kp TAB          &kp Q   &kp W        &kp E         &kp R      &kp T                                          &kp Y            &kp U   &kp I             &kp O          &kp P     &kp BACKSPACE
&kp ESC          &kp A   &kp S        &kp D         &kp F      &kp G                                          &kp H            &kp J   &kp K             &kp L          &kp SEMI  &kp MINUS
&mt LSHIFT CAPS  &kp Z   &mtt LALT X  &mtt LCTRL C  &kp V      &kp B            &kp PRINTSCREEN    &mic_mute  &kp N            &kp M   &mtt RCTRL COMMA  &mtt RALT DOT  &kp FSLH  &kp RSHFT
                         &trans       &trans        &kp LCTRL  &mtt LGUI SPACE  &mo 1              &kp ENTER  &mtt RGUI SPACE  &mo 2   &trans            &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRI_INC C_BRI_DEC>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&trans                          &trans    &trans  &trans  &trans  &trans                       &trans    &trans     &trans     &trans     &trans         &trans
&mtt (LC(LS(GRAVE))) LC(GRAVE)  &kp SQT   &mod_7  &mod_8  &mod_9  &kp PRCNT                    &kp HOME  &kp PG_DN  &kp PG_DN  &kp END    &kp LC(PG_UP)  &kp DEL
&kp TILDE                       &kp HASH  &mod_4  &mod_5  &mod_6  &kp CARET                    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp LC(PG_DN)  &trans
&kp F7                          &mod_0    &mod_1  &mod_2  &mod_3  &kp DLLR   &trans    &trans  &kp F1    &kp F2     &kp F3     &kp F4     &kp F5         &kp F6
                                          &trans  &trans  &trans  &trans     &trans    &trans  &trans    &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PG_DN) LC(PG_UP) &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans     &trans     &trans            &trans         &trans            &trans                       &trans    &trans    &trans    &trans     &trans    &trans
&kp GRAVE  &kp DQT    &kp KP_N7         &kp KP_N8      &kp KP_N9         &kp AT                       &kp AMPS  &kp LBRC  &kp RBRC  &kp LBKT   &kp RBKT  &kp DEL
&kp COMMA  &kp DOT    &kp KP_N4         &kp KP_N5      &kp KP_N6         &kp EQUAL                    &kp PIPE  &kp LPAR  &kp RPAR  &kp ASTRK  &kp PLUS  &kp LS(F12)
&kp BSLH   &kp KP_N0  &mt LC(KP_N1) N1  &mt LC(N2) N2  &mt LC(KP_N3) N3  &kp EXCL   &trans    &trans  &kp F7    &kp F8    &kp F9    &kp F10    &kp F11   &kp F12
                      &trans            &trans         &trans            &trans     &trans    &trans  &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PG_DN) LC(PG_UP) &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PG_DN) LC(PG_UP) &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
