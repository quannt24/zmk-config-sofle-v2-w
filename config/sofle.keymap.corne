#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        mod_1: mod_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N1)>;
            label = "MOD_1";
        };

        mod_2: mod_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N2)>;
            label = "MOD_2";
        };

        mod_3: mod_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N3)>;
            label = "MOD_3";
        };

        mod_4: mod_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N4)>;
            label = "MOD_4";
        };

        mod_5: mod_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N5)>;
            label = "MOD_5";
        };

        mod_6: mod_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N6)>;
            label = "MOD_6";
        };

        mod_7: mod_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N7)>;
            label = "MOD_7";
        };

        mod_8: mod_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N8)>;
            label = "MOD_8";
        };

        mod_9: mod_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N9)>;
            label = "MOD_9";
        };

        mod_0: mod_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(N0)>;
            label = "MOD_0";
        };
    };

    behaviors {
        mtt: mtt {
            compatible = "zmk,behavior-hold-tap";
            label = "MTT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mt: mt {
            compatible = "zmk,behavior-hold-tap";
            label = "MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans           &trans  &trans       &trans        &trans     &trans                                &trans           &trans  &trans            &trans         &trans    &trans
&kp TAB          &kp Q   &kp W        &kp E         &kp R      &kp T                                 &kp Y            &kp U   &kp I             &kp O          &kp P     &kp BACKSPACE
&kp ESC          &kp A   &kp S        &kp D         &kp F      &kp G                                 &kp H            &kp J   &kp K             &kp L          &kp SEMI  &kp MINUS
&mt LSHIFT CAPS  &kp Z   &mtt LALT X  &mtt LCTRL C  &kp V      &kp B            &trans    &trans     &kp N            &kp M   &mtt RCTRL COMMA  &mtt RALT DOT  &kp FSLH  &kp RSHFT
                         &trans       &trans        &kp LCTRL  &mtt LGUI SPACE  &mo 1     &kp ENTER  &mtt RGUI SPACE  &mo 2   &trans            &trans
            >;
        };

        layer_1 {
            bindings = <
&trans     &trans    &trans             &trans                &trans                 &trans                      &trans     &trans  &trans  &trans  &trans     &trans
&kp GRAVE  &kp APOS  &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp HASH                    &kp AT     &kp N7  &kp N8  &kp N9  &kp N0     &kp DEL
&kp BSLH   &kp LBKT  &kp RBKT           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE                    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp DOT    &kp ASTRK
&kp F1     &kp F2    &kp F3             &kp F4                &kp F5                 &kp F6    &trans    &trans  &kp EXCL   &kp N1  &kp N2  &kp N3  &kp COMMA  &kp AMPS
                     &trans             &trans                &trans                 &trans    &trans    &trans  &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans         &trans         &trans    &trans    &trans     &trans                           &trans     &trans  &trans  &trans  &trans  &trans
&kp RC(GRAVE)  &kp RC(PG_UP)  &kp HOME  &kp UP    &kp END    &kp PAGE_UP                      &kp PRCNT  &mod_7  &mod_8  &mod_9  &mod_0  &trans
&trans         &kp RC(PG_DN)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN                    &kp CARET  &mod_4  &mod_5  &mod_6  &trans  &trans
&kp F7         &kp F8         &kp F9    &kp F10   &kp F11    &kp F12        &trans    &trans  &kp DLLR   &mod_1  &mod_2  &mod_3  &trans  &trans
                              &trans    &trans    &trans     &trans         &trans    &trans  &trans     &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
